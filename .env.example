# Copy to .env and fill in locally. Never commit .env.
ETHOS_ENV=development
ETHOS_HOST=127.0.0.1
ETHOS_PORT=8000
ETHOS_LOG_LEVEL=INFO
ETHOS_SNAPSHOT_INTERVAL=25
ETHOS_MAX_SIMULATION_ACTIONS=50

# Runtime connection: the restricted ethos_app role, never the migration role.
# DATABASE_URL=postgresql://ethos_app.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=

# Used only to prove RLS denies the anonymous PostgREST role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional shared-secret guard. Empty disables it.
ETHOS_API_KEY=

# Integration tests: all three must be set, or every integration test skips.
# ETHOS_TEST_DATABASE_URL is the runtime role (ethos_app), used to prove its
# restrictions. ETHOS_ADMIN_DATABASE_URL is a separate administrative credential
# used only for setup and teardown, which the runtime role cannot do.
ETHOS_TEST_DATABASE_URL=
ETHOS_ADMIN_DATABASE_URL=
ETHOS_ALLOW_INTEGRATION_WRITES=0
